{
  "name": "launch-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "init:launch": "tsx scripts/init-launch.ts",
    "seo:submit": "tsx scripts/seo-submit.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "db:push": "supabase db push",
    "db:types": "tsx scripts/db-types.ts",
    "db:reset": "supabase db reset"
  },
  "dependencies": {
    "@calcom/embed-react": "1.5.3",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.1",
    "@stripe/stripe-js": "9.13.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "gray-matter": "4.0.3",
    "next": "16.3.1",
    "posthog-js": "1.417.1",
    "posthog-node": "5.49.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "5.0.0",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
