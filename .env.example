# =============================================================================
#  Environment
# =============================================================================
#  Copy to .env.local (pnpm init:launch does this for you, filling in the
#  non-secret values and leaving secrets as TODO_).
#
#  NOTHING here is required. The app boots, builds and renders every page with
#  this file entirely absent — each unconfigured integration degrades to a no-op
#  and logs exactly one warning. Check /api/health to see what is wired up.
#
#  Legend:  [required-for-X] = needed only if you want feature X to work.
# =============================================================================


# ── Launch identity ──────────────────────────────────────────────────────────
# The launch's slug/name/tagline/plans live in launch.config.ts, NOT here —
# one source of truth, written by `pnpm init:launch`. The only identity value
# that belongs in the environment is the site URL, because it legitimately
# differs per deployment (localhost vs preview vs production).
#
# Canonical absolute origin, no trailing slash. Used by sitemap.ts, robots.ts,
# IndexNow submission and Stripe success/cancel URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── PostHog — analytics ──────────────────────────────────────────────── [analytics]
# ONE shared project across every launch. Filter dashboards by `launch_slug`.
# Project settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. US cloud: https://us.i.posthog.com | EU: https://eu.i.posthog.com
# Requests are reverse-proxied through /ingest (see next.config.ts), so ad
# blockers do not eat them. This value configures the proxy destination.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Dashboard host — used so PostHog's toolbar links point at the real app.
# US cloud: https://us.posthog.com | EU: https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Server-side key for webhook-time events (purchase_completed, booking_completed).
# The project API key works here too.
POSTHOG_API_KEY=


# ── Supabase — database ───────────────────────────────────────────────── [database]
# ONE shared project across every launch, one Postgres schema per launch
# (launch_<slug>). After running the migration you MUST add that schema to
# Settings → API → Exposed schemas, or every query 404s.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=
# Used by `pnpm db:types` to generate lib/supabase/types.ts.
SUPABASE_PROJECT_ID=


# ── Stripe — payments ─────────────────────────────────────────────────── [payments]
# ONE account. Per-launch Products/Prices tagged with metadata.launch_slug.
# Test mode by default: the app refuses to start with an sk_live_ key unless
# NODE_ENV=production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=
# Price IDs per plan key in launch.config.ts. They live here rather than in the
# committed config because test-mode and live-mode IDs differ. A plan with no
# Price ID renders its button disabled instead of failing at checkout.
NEXT_PUBLIC_PRICE_STARTER=
NEXT_PUBLIC_PRICE_PRO=


# ── Cal.com — scheduling ────────────────────────────────────────────── [scheduling]
# ONE account, one event type per launch.
# For cal.com/acme/intro-call → USERNAME=acme, EVENT_SLUG=intro-call
NEXT_PUBLIC_CAL_USERNAME=
NEXT_PUBLIC_CAL_EVENT_SLUG=
# The `secret` you set when creating the webhook. Signs the payload as HMAC-SHA256.
CAL_WEBHOOK_SECRET=


# ── Search engines ───────────────────────────────────────────────────────── [seo]
# Google Search Console → Settings → Ownership verification → HTML tag.
# Paste ONLY the content value, not the whole <meta> tag.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Site verification → Meta tag (msvalidate.01 content).
BING_SITE_VERIFICATION=
# 8–128 hex chars. Generated by `pnpm init:launch`, which also writes the
# matching public/<key>.txt. Powers `pnpm seo:submit` (Bing, Yandex, Seznam,
# Naver). Google does not participate in IndexNow — see docs/SETUP.md.
INDEXNOW_KEY=
